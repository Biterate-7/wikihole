{
  "name": "wikihole",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "cross-env LIVE_WIKIPEDIA=1 vitest run tests/live",
    "test:e2e": "next build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:live && npm run test:e2e",
    "pipeline": "node --disable-warning=ExperimentalWarning --import tsx pipeline/cli.ts",
    "test:visual": "node tests/visual/capture.mjs tests/visual/out/current && node tests/visual/compare.mjs tests/visual/baseline tests/visual/out/current tests/visual/out/diff"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "katex": "^0.19.1",
    "next": "16.4.3",
    "node-html-parser": "^9.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}

# WikiHole environment variables. Every variable is optional: the app runs
# fully without any of them (AI enrichment is simply disabled).
# Copy to .env.local for local development. Never commit real keys.

# --- Wikimedia API etiquette -------------------------------------------------
# Wikimedia asks API clients to send a descriptive User-Agent with a way to
# contact the operator: https://meta.wikimedia.org/wiki/User-Agent_policy
# Example: "WikiHole/1.0 (https://wikihole.example; ops@wikihole.example)"
WIKIMEDIA_USER_AGENT=

# Override the Wikipedia endpoints (useful for testing failure handling or
# pointing at another language edition). Defaults to English Wikipedia.
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
WIKIPEDIA_REST_URL=https://en.wikipedia.org/api/rest_v1

# --- Optional AI enrichment ----------------------------------------------------
# Leave AI_API_KEY empty to disable AI features entirely; everything else keeps
# working on deterministic extraction. AI output is generated only from the
# retrieved Wikipedia text, schema-validated, and each claim must carry a
# verbatim quote that is verified against the article before it is shown.
# AI_PROVIDER: currently "anthropic" (Claude, via the official SDK).
AI_PROVIDER=anthropic
# Anthropic API key (ANTHROPIC_API_KEY is also accepted). Server-side only.
AI_API_KEY=
# Model id. Default: claude-opus-5-5. Any Claude model id works here.
AI_MODEL=

# --- Discovery model ---------------------------------------------------------
# Optional JSON override of the ranking weights (values are relative; they are
# normalised to sum to 1). Keys: technical, quality, depth, obscurity,
# diversity, exploration.
# DISCOVERY_WEIGHTS={"technical":25,"quality":20,"depth":20,"obscurity":15,"diversity":10,"exploration":10}
DISCOVERY_WEIGHTS=

# --- Discovery pipeline (offline; see docs/discovery-pipeline.md) ------------------
# How the pipeline identifies itself to Hacker News, Lemmy, Tildes and Wikimedia.
WIKIHOLE_PIPELINE_USER_AGENT=
# Model for `npm run pipeline -- classify:ai`, which needs AI_API_KEY and spends money.
AI_CLASSIFIER_MODEL=
# Where the app reads the published snapshot. Defaults to data/snapshot.
WIKIHOLE_SNAPSHOT_DIR=
